#!/bin/sh
# Riku runtime plugin: Go
# Handles apps with go.mod or *.go files.
set -eu

CMD="${1:-}"
APP_PATH="${RIKU_APP_PATH:-$(pwd)}"

case "$CMD" in
  detect)
    [ -f "$APP_PATH/go.mod" ] \
      || find "$APP_PATH" -maxdepth 1 -name "*.go" -quit 2>/dev/null | grep -q . \
      && exit 0
    exit 1
    ;;

  build)
    cd "$APP_PATH"
    if ! command -v go >/dev/null 2>&1; then
      echo "Go is not installed on this server (go not found). Install Go, then push again." >&2
      exit 1
    fi
    if [ -f "go.mod" ]; then
      go mod download
    fi
    # -buildvcs=false: the app dir is a fresh clone made by the deploy hook
    # itself (git_ops::sync_app_repo), whose own subprocess environment can
    # carry inherited GIT_* vars (e.g. GIT_DIR) from git's own hook
    # invocation. Go's automatic VCS stamping shells out to git and can fail
    # against that inherited state (exit 128, "error obtaining VCS status")
    # even though the clone itself is perfectly valid -- there is no build
    # provenance value in stamping a riku deploy's throwaway working copy.
    go build -buildvcs=false -o app .
    ;;

  env)
    printf 'CGO_ENABLED=0\n'
    ;;

  start)
    echo "./app"
    ;;

  destroy)
    # Nothing runs outside the app directory.
    exit 0
    ;;
  *)
    printf 'Unknown subcommand: %s\n' "$CMD" >&2
    exit 1
    ;;
esac
