#!/usr/bin/env bash
# Riku runtime plugin: Python
# Handles apps with requirements.txt, pyproject.toml, or setup.py.
# Builds with uv when it is installed (recommended), else with pip.
set -euo pipefail

CMD="${1:-}"
APP_PATH="${RIKU_APP_PATH:-$(pwd)}"
VENV_PATH="$APP_PATH/.venv"

# uv's installer puts it in ~/.local/bin (older versions: ~/.cargo/bin),
# which a git push deploy does not have on PATH.
PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

# RIKU_PYTHON_VERSION (riku.toml [runtime] version, or the app's ENV) picks
# the interpreter: uv fetches it when it is missing, pip needs python<version>
# installed. A venv made for another version is made again.
PYTHON_VERSION="${RIKU_PYTHON_VERSION:-}"
VERSION_MARK="$VENV_PATH/.riku-python-version"
UV_PYTHON=()
if [ -n "$PYTHON_VERSION" ]; then
  UV_PYTHON=(--python "$PYTHON_VERSION")
fi

# Drop a venv made for another RIKU_PYTHON_VERSION than the one asked for now.
# A venv with no mark and no version asked keeps working as before.
drop_stale_venv() {
  if [ -d "$VENV_PATH" ] && [ "$(cat "$VERSION_MARK" 2>/dev/null)" != "$PYTHON_VERSION" ]; then
    rm -rf "$VENV_PATH"
  fi
}

mark_venv() {
  if [ -d "$VENV_PATH" ]; then
    printf '%s' "$PYTHON_VERSION" > "$VERSION_MARK"
  fi
}

# Install with uv: from uv.lock when the app has one (fails when the lock is
# out of date, like a frozen install), else from requirements.txt or the
# project itself. Any failure stops the build.
build_with_uv() {
  if [ -f uv.lock ]; then
    UV_PROJECT_ENVIRONMENT="$VENV_PATH" uv sync ${UV_PYTHON[@]+"${UV_PYTHON[@]}"} --locked --no-dev
    return
  fi
  drop_stale_venv
  [ -d "$VENV_PATH" ] || uv venv ${UV_PYTHON[@]+"${UV_PYTHON[@]}"} "$VENV_PATH"
  mark_venv
  export VIRTUAL_ENV="$VENV_PATH"
  if [ -f requirements.txt ]; then
    uv pip install -r requirements.txt
  elif [ -f pyproject.toml ]; then
    uv pip install -e .
  elif [ -f setup.py ]; then
    uv pip install .
  fi
}

build_with_pip() {
  local python="python3"
  if [ -n "$PYTHON_VERSION" ]; then
    python="python$PYTHON_VERSION"
    if ! command -v "$python" >/dev/null 2>&1; then
      echo "RIKU_PYTHON_VERSION is $PYTHON_VERSION but $python is not installed on the server." >&2
      echo "Install it, or install uv, which fetches the interpreter itself." >&2
      exit 1
    fi
  fi
  drop_stale_venv
  [ -d "$VENV_PATH" ] || "$python" -m venv "$VENV_PATH"
  mark_venv
  # shellcheck disable=SC1091
  source "$VENV_PATH/bin/activate"
  if [ -f requirements.txt ]; then
    pip install -r requirements.txt
  elif [ -f pyproject.toml ]; then
    pip install -e .
  elif [ -f setup.py ]; then
    pip install .
  fi
}

case "$CMD" in
  detect)
    [ -f "$APP_PATH/requirements.txt" ] \
      || [ -f "$APP_PATH/pyproject.toml" ] \
      || [ -f "$APP_PATH/setup.py" ] \
      && exit 0
    exit 1
    ;;

  build)
    cd "$APP_PATH"
    if ! command -v uv >/dev/null 2>&1 && [ -z "$PYTHON_VERSION" ] && ! command -v python3 >/dev/null 2>&1; then
      echo "Python is not installed on this server (python3 not found). Install Python 3 or uv, then push again." >&2
      exit 1
    fi
    if command -v uv >/dev/null 2>&1; then
      build_with_uv
    else
      echo "uv not found, building with pip. Install uv for faster, locked builds:" >&2
      echo "  curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
      build_with_pip
    fi
    ;;

  env)
    printf 'VIRTUAL_ENV=%s\n' "$VENV_PATH"
    printf 'PATH=%s/bin:%s\n' "$VENV_PATH" "$PATH"
    ;;

  start)
    echo "python app.py"
    ;;

  destroy)
    # Nothing runs outside the app directory.
    exit 0
    ;;
  *)
    echo "Unknown subcommand: $CMD" >&2
    exit 1
    ;;
esac
