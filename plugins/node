#!/usr/bin/env bash
# Riku runtime plugin: Node.js
# Handles apps with a package.json.
set -euo pipefail

CMD="${1:-}"
APP_PATH="${RIKU_APP_PATH:-$(pwd)}"

case "$CMD" in
  detect)
    [ -f "$APP_PATH/package.json" ] && exit 0
    exit 1
    ;;

  build)
    cd "$APP_PATH"
    if ! command -v nub >/dev/null 2>&1 && ! command -v npm >/dev/null 2>&1; then
      echo "Node.js is not installed on this server (npm not found). Install Node.js, then push again." >&2
      exit 1
    fi
    # RIKU_NODE_VERSION (riku.toml [runtime] version) names a major, a
    # major.minor or an exact version. riku uses the server's node, so a
    # mismatch fails here rather than running the app on the wrong one.
    wanted="${RIKU_NODE_VERSION:-}"
    wanted="${wanted#v}"
    wanted="${wanted%.x}"
    if [ -n "$wanted" ]; then
      installed="$(node --version 2>/dev/null || true)"
      installed="${installed#v}"
      case "$installed." in
        "$wanted".*) ;;
        *)
          echo "RIKU_NODE_VERSION is $wanted, but this server's node is ${installed:-not installed}." >&2
          echo "Install node $wanted on the server, or change [runtime] version in riku.toml." >&2
          exit 1
          ;;
      esac
    fi
    # Prefer nub: a single Rust binary that reads npm/pnpm/bun lockfiles
    # directly (https://nubjs.com). Fall back to npm on a server without
    # nub.
    if command -v nub >/dev/null 2>&1; then
      has_lock=0
      for lock in package-lock.json pnpm-lock.yaml lock.yaml bun.lock; do
        [ -f "$lock" ] && has_lock=1
      done
      if [ "$has_lock" -eq 1 ]; then
        # `nub ci` has no --prod/-P flag (unlike `nub install`) -- use
        # `install --frozen-lockfile` instead for the same "fail on lockfile
        # drift" guarantee plus production-only deps.
        nub install --frozen-lockfile --prod
      else
        nub install --prod
      fi
    else
      echo "nub not found, building with npm. Install nub for faster, lockfile exact builds:" >&2
      echo "  npm install -g @nubjs/nub" >&2
      if [ -f "package-lock.json" ]; then
        npm ci --production
      else
        npm install --production
      fi
    fi
    ;;

  env)
    printf 'NODE_ENV=production\n'
    printf 'PATH=%s/node_modules/.bin:%s\n' "$APP_PATH" "$PATH"
    ;;

  start)
    APP_PATH="${RIKU_APP_PATH:-$(pwd)}"
    if [ -f "$APP_PATH/package.json" ]; then
      # The path goes through the environment, never into the script text,
      # so a quote in it cannot break or change the JavaScript.
      main=$(RIKU_PACKAGE_JSON="$APP_PATH/package.json" \
        node -e "try{console.log(require(process.env.RIKU_PACKAGE_JSON).main||'')}catch(e){}" 2>/dev/null || true)
      if [ -n "$main" ]; then
        echo "node $main"
      else
        echo "node index.js"
      fi
    else
      echo "node index.js"
    fi
    ;;

  destroy)
    # Nothing runs outside the app directory.
    exit 0
    ;;
  *)
    echo "Unknown subcommand: $CMD" >&2
    exit 1
    ;;
esac
