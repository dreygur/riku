{% include "nginx_acme.conf.tera" %}
{% if RIKU_STATIC_ALIASES | length > 0 %}
  # Static path mappings, published outside the deploy home
{% for static in RIKU_STATIC_ALIASES %}
  location {{ static.location }} {
    alias {{ static.alias }};
    expires 30d;
    add_header Cache-Control "public, immutable";
  }
{% endfor %}
{% endif %}
