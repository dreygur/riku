upstream {{ APP }}_UPSTREAM {
  server {{ RIKU_NGINX_SOCKET }};
}

server {
  listen              {{ RIKU_NGINX_IPV4_ADDRESS }}:80;
{% if RIKU_NGINX_IPV6_ADDRESS %}
  listen              {{ RIKU_NGINX_IPV6_ADDRESS }}:80;
{% endif %}
  server_name         {{ RIKU_DOMAINS }};

  location ^~ /.well-known/acme-challenge {
    allow all;
    root {{ ACME_WWW }};
  }

  return 301 https://{{ RIKU_DOMAINS }}$request_uri;
}

server {
  listen              {{ RIKU_NGINX_IPV4_ADDRESS }}:443 ssl http2;
{% if RIKU_NGINX_IPV6_ADDRESS %}
  listen              {{ RIKU_NGINX_IPV6_ADDRESS }}:443 ssl http2;
{% endif %}
  server_name         {{ RIKU_DOMAINS }};

  ssl_certificate     {{ RIKU_NGINX_ROOT }}/{{ APP }}.crt;
  ssl_certificate_key {{ RIKU_NGINX_ROOT }}/{{ APP }}.key;

  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         HIGH:!aNULL:!MD5;

  # HSTS: tell browsers to always use HTTPS (1 year)
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location ^~ /.well-known/acme-challenge {
    allow all;
    root {{ ACME_WWW }};
  }

{% include "nginx_common.conf.tera" %}
}
