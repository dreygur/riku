{% include "nginx_upstream.conf.tera" %}
{% include "nginx_cache_path.conf.tera" %}

server {
  listen              {{ RIKU_NGINX_IPV4_ADDRESS }}:80;
{% if RIKU_NGINX_IPV6_ADDRESS %}
  listen              {{ RIKU_NGINX_IPV6_ADDRESS }}:80;
{% endif %}
  server_name         {{ RIKU_DOMAINS }};

{% include "nginx_acme.conf.tera" %}

  location / {
    return 301 https://{{ RIKU_DOMAINS }}$request_uri;
  }
}

server {
  listen              {{ RIKU_NGINX_IPV4_ADDRESS }}:443 ssl http2;
{% if RIKU_NGINX_IPV6_ADDRESS %}
  listen              {{ RIKU_NGINX_IPV6_ADDRESS }}:443 ssl http2;
{% endif %}
  server_name         {{ RIKU_DOMAINS }};

  ssl_certificate     {{ SSL_CERTIFICATE }};
  ssl_certificate_key {{ SSL_CERTIFICATE_KEY }};

  ssl_protocols       TLSv1.2 TLSv1.3;
  ssl_ciphers         HIGH:!aNULL:!MD5;

  # HSTS: tell browsers to always use HTTPS (1 year)
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

{% include "nginx_common.conf.tera" %}
}
