{% include "nginx_upstream.conf.tera" %}

server {
  listen              {{ RIKU_NGINX_IPV4_ADDRESS }}:{{ RIKU_NGINX_EXTERNAL_PORT }};
{% if RIKU_NGINX_IPV6_ADDRESS %}
  listen              {{ RIKU_NGINX_IPV6_ADDRESS }}:{{ RIKU_NGINX_EXTERNAL_PORT }};
{% endif %}
  server_name         {{ RIKU_DOMAINS }};

{% include "nginx_site_locations.conf.tera" %}

  location / {
    proxy_pass http://{{ APP_UPSTREAM }};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Request-Start $msec;
    proxy_redirect off;
  }

  # Enable gzip compression
  # A directive the app's snippet sets is left out here: nginx refuses
  # a duplicate.
{% if "gzip" not in RIKU_NGINX_SNIPPET_DIRECTIVES %}
  gzip on;
{% endif %}
  gzip_proxied any;
{% if "gzip_types" not in RIKU_NGINX_SNIPPET_DIRECTIVES %}
  gzip_types text/plain text/xml text/css text/javascript text/js application/x-javascript application/javascript application/json application/xml+rss application/atom+xml image/svg+xml;
{% endif %}
{% if "gzip_comp_level" not in RIKU_NGINX_SNIPPET_DIRECTIVES %}
  gzip_comp_level 7;
{% endif %}
{% if "gzip_min_length" not in RIKU_NGINX_SNIPPET_DIRECTIVES %}
  gzip_min_length 2048;
{% endif %}
{% if "gzip_vary" not in RIKU_NGINX_SNIPPET_DIRECTIVES %}
  gzip_vary on;
{% endif %}
  gzip_disable "MSIE [1-6]\.(?!.*SV1)";

  # Security headers
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-XSS-Protection "1; mode=block" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header X-Deployed-By "Riku" always;

{% if RIKU_NGINX_INCLUDE_CONTENT %}
  # Custom nginx configuration from file
  {{ RIKU_NGINX_INCLUDE_CONTENT }}
{% endif %}
}
