{% include "nginx_upstream.conf.tera" %}

server {
  {% if DOMAIN_LISTEN %}listen              0.0.0.0:80;{% endif %}
  {% if IPV6 and DOMAIN_LISTEN %}listen              [::]:80;{% endif %}
{% include "nginx_open_port.conf.tera" %}
  server_name         {{ RIKU_DOMAINS }};
{% include "nginx_also_tls.conf.tera" %}

{% include "nginx_common.conf.tera" %}
}
