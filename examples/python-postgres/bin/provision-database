#!/bin/sh

echo "Db/server name: [${RIKU_DOMAINS}]"

if [ "${RIKU_DOMAINS}" = "" ]
then
  echo "Skipping db creation as RIKU_DOMAINS is not set."
else
  psql "${RIKU_DOMAINS}" -c ";" 2>/dev/null && echo "Database ${RIKU_DOMAINS} already exists" || createdb "${RIKU_DOMAINS}"
fi

./manage.py migrate --no-input
./manage.py collectstatic --no-input
